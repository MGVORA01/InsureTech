# Backend environment template.
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT: Copy this file to backend/.env and fill in real values.
# RENDER DEPLOYMENT: Set all variables in Render Dashboard → Environment.
#                    Do NOT rely on .env on Render — it is not read in production.
# ─────────────────────────────────────────────────────────────────────────────

# Render provides a managed Postgres DATABASE_URL automatically.
# Paste it here for local testing, or set it in the Render dashboard for prod.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/insuretech

# Groq AI (https://console.groq.com → API Keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.7

# JWT / Auth
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=5
EMAIL_OTP_EXPIRE_MINUTES=5

# Cloudinary (optional — for PDF/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

LOG_LEVEL=INFO
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────────
# CORS — set to your deployed frontend URL(s) on Render.
# Comma-separated if you have multiple origins.
# Example for Vercel: https://your-app.vercel.app
# Example for custom domain: https://your-app.vercel.app,https://insuretech.in
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — Render free tier blocks outbound SMTP.
# Use Brevo's HTTPS email API (https://app.brevo.com → SMTP & API → API Keys).
# ─────────────────────────────────────────────────────────────────────────────
MAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=aiinsuretech@gmail.com
MAIL_FROM_NAME=AI InsureTech
MAIL_TIMEOUT_SECONDS=20
