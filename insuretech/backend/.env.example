# Backend environment template.
# Copy this file to backend/.env and fill in real values before running the backend.

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/insuretech
MONGODB_URL=mongodb+srv://user:password@cluster.example.mongodb.net/
MONGODB_DB_NAME=insuretech_ai

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.7

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=5
EMAIL_OTP_EXPIRE_MINUTES=5

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

LOG_LEVEL=INFO

FRONTEND_URL=http://localhost:5173

# Render Free blocks outbound SMTP ports. Use an HTTPS email API in production.
MAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=your_email@example.com
MAIL_FROM_NAME=Insuretech
MAIL_TIMEOUT_SECONDS=20
