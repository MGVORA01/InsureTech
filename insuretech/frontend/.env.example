# Frontend environment template.
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT: Copy this file to frontend/.env and set values below.
# VERCEL DEPLOYMENT: Set all variables in Vercel Dashboard → Settings → Environment Variables.
#                    Do NOT rely on .env in production — it is not read by Vercel for deployments.
# ─────────────────────────────────────────────────────────────────────────────

# Your backend URL.
# Local: http://localhost:8000
# Render: https://your-backend.onrender.com  ← set this in Vercel dashboard for production
VITE_API_URL=http://localhost:8000
